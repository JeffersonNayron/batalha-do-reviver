APP_ENV=development
DATABASE_URL=sqlite:///./reviver.db
# Crie uma senha hash Argon2 localmente: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
# Valor aleatório de pelo menos 32 caracteres, mantenha em segredo
SESSION_SECRET=
# Opcional caso o frontend seja hospedado em outro domínio
ALLOWED_ORIGIN=
# Recuperação por e-mail (com URL pública HTTPS e SMTP com STARTTLS)
PUBLIC_BASE_URL=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
