{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Reviver: iniciar portal",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["-m", "uvicorn", "api.main:app", "--reload", "--port", "8000", "--env-file", ".env"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Reviver: rodar testes",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": {"kind": "test", "isDefault": true}
    }
  ]
}
